<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.bubbles.server</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/bubbles</string>
		<string>serve</string>
		<string>--data-dir</string>
		<string>/Library/Application Support/bubbles</string>
	</array>
	<key>WorkingDirectory</key>
	<string>/Library/Application Support/bubbles</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/var/log/bubbles.log</string>
	<key>StandardErrorPath</key>
	<string>/var/log/bubbles.log</string>
</dict>
</plist>
