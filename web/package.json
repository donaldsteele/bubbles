{
  "name": "bubbles-web",
  "private": true,
  "version": "0.0.0",
  "description": "bubbles web client: Svelte 5 single-page app embedded in the server",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/copy-emoji.mjs && vite build && node scripts/check-origins.mjs && node scripts/size-check.mjs",
    "check": "svelte-check --fail-on-warnings && eslint . && prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "gen:api": "openapi-typescript ../docs/openapi.yaml -o src/lib/api/schema.d.ts && prettier --write src/lib/api/schema.d.ts",
    "check:api": "node scripts/check-api.mjs",
    "check:origins": "node scripts/check-origins.mjs",
    "check:size": "node scripts/size-check.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@resvg/resvg-js": "2.6.2",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/svelte": "5.4.2",
    "@types/markdown-it": "14.2.0",
    "@types/node": "26.6.5",
    "emojibase-data": "17.0.0",
    "eslint": "10.12.0",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.3",
    "workbox-build": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1",
    "workbox-window": "7.4.1"
  },
  "dependencies": {
    "@lucide/svelte": "1.55.0",
    "dompurify": "3.4.16",
    "markdown-it": "15.0.2",
    "openapi-fetch": "0.17.0",
    "uqr": "0.1.3"
  }
}
